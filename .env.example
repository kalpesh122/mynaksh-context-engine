# Which LLM provider to use: mock | openai | anthropic
LLM_PROVIDER=mock

# Only needed when LLM_PROVIDER is not "mock".
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Ports
PORT=3000
UPSTREAM_PORT=4001
UPSTREAM_BASE_URL=http://127.0.0.1:4001

# Resilience
UPSTREAM_TIMEOUT_MS=800
UPSTREAM_RETRIES=2

# Fault injection for the mock upstream (0..1 probability per request)
UPSTREAM_FAILURE_RATE=0
UPSTREAM_LATENCY_MS=40
